    "# HR/HRV 타임라인 시각화 (Baseline/Stress/Amusement 구간 배경 표시)\n",
    "from scipy.signal import find_peaks\n",
    "\n",
    "\n",
    "def _extract_hr_hrv_window(bvp_window, fs=64):\n",
    "    if len(bvp_window) < fs * 5:\n",
    "        return None, None\n",
    "\n",
    "    peaks, _ = find_peaks(\n",
    "        bvp_window,\n",
    "        distance=int(fs * 0.5),\n",
    "        prominence=np.std(bvp_window) * 0.2,\n",
    "    )\n",
    "\n",
    "    if len(peaks) < 3:\n",
    "        return None, None\n",
    "\n",
    "    ibi = np.diff(peaks) / fs\n",
    "    ibi = ibi[(ibi > 0.4) & (ibi < 2.0)]  # 30~150 BPM 범위\n",
    "\n",
    "    if len(ibi) < 2:\n",
    "        return None, None\n",
    "\n",
    "    hr = 60.0 / np.mean(ibi)\n",
    "    hrv = np.std(ibi) * 1000.0  # SDNN(ms)\n",
    "    return hr, hrv\n",
    "\n",
    "\n",
    "def plot_subject_hr_hrv_timeline(subject_id=\"S2\", window_sec=30, overlap=0.5):\n",
    "    pkl_path = WESAD_ROOT / subject_id / f\"{subject_id}.pkl\"\n",
    "    if not pkl_path.exists():\n",
    "        print(f\"Missing subject file: {pkl_path}\")\n",
    "        return\n",
    "\n",
    "    with open(pkl_path, \"rb\") as f:\n",
    "        data = pickle.load(f, encoding=\"latin1\")\n",
    "\n",
    "    bvp_64hz = data[\"signal\"][\"wrist\"][\"BVP\"].reshape(-1)\n",
    "    labels_700hz = data[\"label\"].reshape(-1)\n",
    "\n",
    "    labels_64hz = labels_700hz[::11]\n",
    "    n = min(len(bvp_64hz), len(labels_64hz))\n",
    "    bvp_64hz = bvp_64hz[:n]\n",
    "    labels_64hz = labels_64hz[:n]\n",
    "\n",
    "    labels_1hz = downsample_labels_1hz(labels_700hz)\n",
    "    time_1hz_min = np.arange(len(labels_1hz)) / 60.0\n",
    "\n",
    "    fs = 64\n",
    "    window_samples = int(window_sec * fs)\n",
    "    step_samples = max(1, int(window_samples * (1 - overlap)))\n",
    "\n",
    "    time_min = []\n",
    "    hr_vals = []\n",
    "    hrv_vals = []\n",
    "    state_vals = []\n",
    "\n",
    "    for start in range(0, len(bvp_64hz) - window_samples + 1, step_samples):\n",
    "        end = start + window_samples\n",
    "        window_bvp = bvp_64hz[start:end]\n",
    "        hr, hrv = _extract_hr_hrv_window(window_bvp, fs=fs)\n",
    "\n",
    "        if hr is None or hrv is None:\n",
    "            continue\n",
    "\n",
    "        center_t_min = ((start + end) / 2.0) / fs / 60.0\n",
    "        time_min.append(center_t_min)\n",
    "        hr_vals.append(hr)\n",
    "        hrv_vals.append(hrv)\n",
    "\n",
    "        window_labels = labels_64hz[start:end]\n",
    "        valid = window_labels[np.isin(window_labels, [1, 2, 3])]\n",
    "        if len(valid) > 0:\n",
    "            state_vals.append(int(np.bincount(valid.astype(int)).argmax()))\n",
    "        else:\n",
    "            state_vals.append(0)\n",
    "\n",
    "    if len(time_min) == 0:\n",
    "        print(\"❌ HR/HRV 추출 실패: 유효한 윈도우가 없습니다.\")\n",
    "        return\n",
    "\n",
    "    time_min = np.array(time_min)\n",
    "    hr_vals = np.array(hr_vals)\n",
    "    hrv_vals = np.array(hrv_vals)\n",
    "    state_vals = np.array(state_vals)\n",
    "\n",
    "    fig, axes = plt.subplots(2, 1, figsize=(20, 9), sharex=True)\n",
    "    fig.suptitle(\n",
    "        f\"{subject_id} HR/HRV Timeline (Window={window_sec}s, overlap={int(overlap*100)}%)\",\n",
    "        fontsize=14,\n",
    "        fontweight=\"bold\",\n",
    "    )\n",
    "\n",
    "    # HR plot\n",
    "    ax = axes[0]\n",
    "    add_stimulus_background(ax, labels_1hz, time_1hz_min)\n",
    "    ax.plot(time_min, hr_vals, color=\"#e67e22\", linewidth=1.5, label=\"HR\")\n",
    "    for state_id in [1, 2, 3]:\n",
    "        mask = state_vals == state_id\n",
    "        if np.any(mask):\n",
    "            ax.scatter(time_min[mask], hr_vals[mask], s=10, color=STATE_COLORS[state_id], alpha=0.65)\n",
    "    ax.set_ylabel(\"Heart Rate (BPM)\", fontsize=11, fontweight=\"bold\")\n",
    "    ax.set_title(\"HR Timeline with Stimulus Segments\", fontsize=12, fontweight=\"bold\")\n",
    "    ax.grid(True, alpha=0.3)\n",
    "\n",
    "    handles, labels_legend = ax.get_legend_handles_labels()\n",
    "    if handles:\n",
    "        by_label = dict(zip(labels_legend, handles))\n",
    "        ax.legend(by_label.values(), by_label.keys(), loc=\"upper right\", fontsize=10, ncol=4)\n",
    "\n",
    "    # HRV plot\n",
    "    ax = axes[1]\n",
    "    add_stimulus_background(ax, labels_1hz, time_1hz_min)\n",
    "    ax.plot(time_min, hrv_vals, color=\"#9b59b6\", linewidth=1.5, label=\"HRV (SDNN)\")\n",
    "    for state_id in [1, 2, 3]:\n",
    "        mask = state_vals == state_id\n",
    "        if np.any(mask):\n",
    "            ax.scatter(time_min[mask], hrv_vals[mask], s=10, color=STATE_COLORS[state_id], alpha=0.65)\n",
    "    ax.set_ylabel(\"HRV - SDNN (ms)\", fontsize=11, fontweight=\"bold\")\n",
    "    ax.set_title(\"HRV Timeline with Stimulus Segments\", fontsize=12, fontweight=\"bold\")\n",
    "    ax.set_xlabel(\"Time (minutes)\", fontsize=11, fontweight=\"bold\")\n",
    "    ax.grid(True, alpha=0.3)\n",
    "\n",
    "    handles, labels_legend = ax.get_legend_handles_labels()\n",
    "    if handles:\n",
    "        by_label = dict(zip(labels_legend, handles))\n",
    "        ax.legend(by_label.values(), by_label.keys(), loc=\"upper right\", fontsize=10, ncol=4)\n",
    "\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "\n",
    "# 예시 실행\n",
    "plot_subject_hr_hrv_timeline(\"S2\", window_sec=30, overlap=0.5)# S2 Analysis: Baseline vs Stress vs Amusement\n",
